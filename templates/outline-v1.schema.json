{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promptforge.local/schemas/outline-v1.schema.json",
  "title": "PromptForge outline v1",
  "description": "Versioned source format for a structured Skill outline or a Markdown document outline.",
  "oneOf": [
    { "$ref": "#/$defs/structured" },
    { "$ref": "#/$defs/document" }
  ],
  "$defs": {
    "structured": {
      "type": "object",
      "not": { "required": ["document"] },
      "required": ["schemaVersion", "description", "steps"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "description": { "type": "string", "minLength": 1 },
        "input": { "type": "string" },
        "result": { "type": "string" },
        "_generatedRevision": { "type": "string" },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } }
      },
      "additionalProperties": true
    },
    "step": {
      "type": "object",
      "required": ["id", "title", "selected"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "title": { "type": "string", "minLength": 1 },
        "selected": { "type": "boolean" },
        "purpose": { "type": "string" },
        "instructions": { "type": "string" },
        "input": { "type": "string" },
        "decision": { "type": "string" },
        "actions": { "type": "string" },
        "observation": { "type": "string" },
        "adjustment": { "type": "string" },
        "output": { "type": "string" },
        "stop": { "type": "string" },
        "scripts": { "$ref": "#/$defs/paths" },
        "references": { "$ref": "#/$defs/paths" },
        "skills": { "$ref": "#/$defs/paths" },
        "capabilities": { "type": "array", "items": { "$ref": "#/$defs/capability" } }
      },
      "additionalProperties": true
    },
    "paths": { "type": "array", "items": { "type": "string" } },
    "capability": {
      "type": "object",
      "required": ["type", "path", "selected"],
      "properties": {
        "type": { "enum": ["script", "reference", "skill", "asset"] },
        "path": { "type": "string" },
        "selected": { "type": "boolean" },
        "usage": { "type": "string" },
        "requires": { "$ref": "#/$defs/paths" }
      },
      "additionalProperties": true
    },
    "document": {
      "type": "object",
      "required": ["schemaVersion", "document"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "document": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "_generatedRevision": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
